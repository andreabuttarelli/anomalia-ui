{
  "name": "@anomalia/ui",
  "version": "0.1.0",
  "description": "Anomalia design system — Apple/shadcn surfaces, Material motion and touch, for SvelteKit.",
  "license": "UNLICENSED",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "scripts",
    "skills",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./theme.css": "./dist/styles/theme.css",
    "./base.css": "./dist/styles/base.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package && publint",
    "build:docs": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run audit:contrast",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "audit:contrast": "node --experimental-strip-types scripts/contrast-audit.mjs",
    "skill:reference": "node --experimental-strip-types scripts/generate-skill-reference.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.31.0",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.2",
    "publint": "^0.2.12",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "design-system",
    "ui",
    "components"
  ]
}
