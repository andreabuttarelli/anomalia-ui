{
  "name": "@anomalia-so/ui",
  "version": "0.1.0",
  "description": "A SvelteKit design system: Apple and shadcn restraint, Material touch and motion, WCAG-audited contrast. 43 components, dark mode, zero runtime dependencies.",
  "keywords": [
    "svelte",
    "sveltekit",
    "svelte5",
    "design-system",
    "component-library",
    "ui-components",
    "ui-library",
    "design-tokens",
    "accessibility",
    "wcag",
    "a11y",
    "dark-mode",
    "material-design",
    "css-variables",
    "typescript"
  ],
  "license": "MIT",
  "author": "Andrea Buttarelli <andrea@teta.so> (https://github.com/andreabuttarelli)",
  "homepage": "https://ui.anomalia.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreabuttarelli/anomalia-ui.git"
  },
  "bugs": {
    "url": "https://github.com/andreabuttarelli/anomalia-ui/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "scripts",
    "skills",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./theme.css": "./dist/styles/theme.css",
    "./base.css": "./dist/styles/base.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "audit:contrast": "node --experimental-strip-types scripts/contrast-audit.mjs",
    "build": "svelte-kit sync && svelte-package && publint",
    "build:docs": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run audit:contrast",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "prepare": "svelte-kit sync && svelte-package",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "skill:reference": "node --experimental-strip-types scripts/generate-skill-reference.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.31.0",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.2",
    "publint": "^0.2.12",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
